(
    // Provisional alignment from two stationary hardware snapshots.
    // Both snapshots have almost the same orientation: validate at different
    // wrist orientations before treating this as a controller frame convention.
    abc: zyx,
    bridge: (
        address: "192.168.3.11:3920",
        stale_after: 0.5,
        connect_timeout: 2.0,
    ),
    base: (translation: (0.0, 0.0, 0.0), rpy: (0.0, 0.0, 0.0)),
    // Known: FHTW URDF link6 -> tool0 has +52.2 mm along local Z.
    // Hypothesis: controller TCP orientation adds 180 degrees around local Z.
    // This rotation is not part of the ROS link6 -> tool0 transform.
    tool: (
        translation: (0.0, 0.0, 0.0522),
        rpy: (0.0, 0.0, 3.141592653589793),
    ),
)
