// The program graph: the `program` task (your steps in src/program.rs) and one
// robot bridge. To use another robot, change the bridge `type`/`config` and
// the program's `chain` and `collision_model` (used for IK, the pre-flight
// collision check, and the planner behind `JPlanned` steps).
(
    runtime: (rate_target_hz: 50),
    tasks: [
        (
            id: "program",
            type: "runner::RobotProgram",
            // Kinematic and collision models: preset names or inline specs
            // (repose_kinematics::CuChainSpec, repose_collision::CuCollisionModelSpec).
            // speed: peak joint speed in deg/s, acceleration in deg/s^2. The
            // bridge caps jog at max_jog_percent (default 10 % = 6 deg/s).
            config: {
                "chain": "igus_rebel",
                "collision_model": "igus_rebel",
                // Planner for JPlanned steps: rrt_connect (default), rrt_star,
                // prm, a_star, stomp, path_optimizer, direct.
                "planner": "rrt_connect",
                "speed": 5.0,
                "acceleration": 20.0,
            },
        ),
    ],
    bridges: [
        (
            id: "robot",
            type: "repose_igus_cri::CuIgusCriBridge",
            config: {
                "address": "{{robot_address}}",
                "allow_control": true,
                "allow_motion": true,
                "velocity_percent": 5.0,
                // Per-joint PID feedback for streamed motion, A1 first, error in
                // degrees: kp 1/s, ki 1/s^2, kd unitless; integral_limit caps
                // the I term as a fraction of the jog cap. Omitted fields keep
                // these defaults. Only P = 2.0 is hardware-verified.
                "joint_gains": [
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                    {"kp": 2.0, "ki": 0.0, "kd": 0.0, "integral_limit": 0.5},
                ],
            },
            channels: [
                Rx(id: "joint_state", msg: "repose_kinematics::CuJointStatePayload<6>"),
                Rx(id: "session_state", msg: "repose_robot_interface::CuSessionState"),
                Tx(id: "session", msg: "repose_robot_interface::CuSessionCommand"),
                Tx(id: "joint_command", msg: "repose_controller::CuJointCommandPayload<6>"),
            ],
        ),
    ],
    cnx: [
        (src: "robot/joint_state", dst: "program", msg: "repose_kinematics::CuJointStatePayload<6>"),
        (src: "robot/session_state", dst: "program", msg: "repose_robot_interface::CuSessionState"),
        (src: "program", dst: "robot/session", msg: "repose_robot_interface::CuSessionCommand"),
        (src: "program", dst: "robot/joint_command", msg: "repose_controller::CuJointCommandPayload<6>"),
    ],
)
