[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false
default-run = "{{project-name}}"

[dependencies]
cu29 = { version = "1.3.1", features = ["units", "reflect"] }
bincode = { package = "cu-bincode", version = "2.2.0", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
ctrlc = "3"
cu-spatial-payloads = "1.3.0"
# Robot bridge, chosen at `cargo generate`.
{% if robot == "igus_rebel" %}repose-igus-cri = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% elsif robot == "ur5e" %}repose-ur = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% else %}repose-mujoco-sim = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
{% endif %}
# Repose: kinematics/IK, collision checking, planning, the robot contract.
repose-controller = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose-kinematics = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose-robot-interface = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose-collision = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose-motion-planning = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }
repose-trajectory = { git = "https://github.com/ReposeRobotics/repose.git", rev = "54e23b9df4e22f65807be765998213a0152c9597" }

# Only for `cargo run --features rrd --bin to_rrd` (Copper log -> Rerun).
cu29-export = { version = "1.3.0", optional = true }
rerun = { version = "0.43.2", default-features = false, features = ["sdk"], optional = true }

[features]
# Builds src/bin/to_rrd.rs; off by default to keep the robot app's build small.
rrd = ["dep:cu29-export", "dep:rerun"]

[[bin]]
name = "{{project-name}}"
path = "src/main.rs"

[[bin]]
name = "to_rrd"
path = "src/bin/to_rrd.rs"
required-features = ["rrd"]

[build-dependencies]
cu29-build = "1.3.0"

[dev-dependencies]
ron = "0.12"
