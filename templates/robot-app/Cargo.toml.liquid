[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

[dependencies]
cu29 = { version = "1.3.1", features = ["units", "reflect"] }
bincode = { package = "cu-bincode", version = "2.2.0", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
ctrlc = "3"
cu-spatial-payloads = "1.3.0"
# Robot bridge, chosen at `cargo generate`. The SO-ARM simulator needs the
# newer Repose with the joint-count-generic MuJoCo bridge; the hardware bridges
# are built against the older pin, so each robot uses its own Repose rev.
{% if robot == "so_arm" %}{% assign repose_rev = "54e23b9df4e22f65807be765998213a0152c9597" %}{% else %}{% assign repose_rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" %}{% endif %}
{% if robot == "igus_rebel" %}repose-igus-cri = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% elsif robot == "ur5e" %}repose-ur = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% else %}repose-mujoco-sim = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
{% endif %}
# Repose: kinematics/IK, collision checking, planning, the robot contract.
repose-controller = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose-kinematics = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose-robot-interface = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose-collision = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose-motion-planning = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }
repose-trajectory = { git = "https://github.com/ReposeRobotics/repose.git", rev = "{{ repose_rev }}" }

[build-dependencies]
cu29-build = "1.3.0"

[dev-dependencies]
ron = "0.12"
