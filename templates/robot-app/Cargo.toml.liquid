[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

[dependencies]
cu29 = { version = "1.3.1", features = ["units", "reflect"] }
bincode = { package = "cu-bincode", version = "2.2.0", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
ctrlc = "3"
cu-spatial-payloads = "1.3.0"
# Robot bridges (pick the robot in copperconfig.ron).
repose-igus-cri = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
repose-ur = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
# Repose: kinematics/IK, collision checking, planning, the robot contract.
repose-controller = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose-kinematics = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose-robot-interface = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose-collision = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose-motion-planning = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }
repose-trajectory = { git = "https://github.com/ReposeRobotics/repose.git", tag = "v0.7.1" }

[build-dependencies]
cu29-build = "1.3.0"
ron = "0.12"
serde = { version = "1", features = ["derive"] }
