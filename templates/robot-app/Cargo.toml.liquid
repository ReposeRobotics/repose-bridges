[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
publish = false

[dependencies]
cu29 = { version = "1.3.1", features = ["units", "reflect"] }
bincode = { package = "cu-bincode", version = "2.2.0", features = ["derive"] }
serde = { version = "1", features = ["derive"] }
ctrlc = "3"
cu-spatial-payloads = "1.3.0"
# Robot bridge, chosen at `cargo generate`.
{% if robot == "igus_rebel" %}repose-igus-cri = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% else %}repose-ur = { git = "https://github.com/ReposeRobotics/repose-bridges.git", branch = "master", features = ["control"] }
{% endif %}
# Repose: kinematics/IK, collision checking, planning, the robot contract.
repose-controller = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose-kinematics = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose-robot-interface = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose-collision = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose-motion-planning = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }
repose-trajectory = { git = "https://github.com/ReposeRobotics/repose.git", rev = "e554cca5eb5d5577bbcb63a11bbaa3da0c43b36c" }

[build-dependencies]
cu29-build = "1.3.0"

[dev-dependencies]
ron = "0.12"
